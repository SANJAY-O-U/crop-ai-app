# CropCast backend configuration -- copy to .env for local use. NEVER commit real values; every value below is a placeholder.
# Render: set these in the service's Environment tab. Validate with:  python -m app.config_check
# (no variable here holds a secret except MODEL_ARTIFACT_TOKEN, if your artifact store is private)

# --- Runtime -------------------------------------------------------------------------------------
# PORT is injected by Render. Start command must bind it:  uvicorn app.main:app --host 0.0.0.0 --port $PORT
# PORT=10000
APP_ENV=production
# Comma-separated https frontend origins allowed by CORS (REQUIRED in production; unset = wildcard "*").
ALLOWED_ORIGINS=https://your-frontend.example.app
LOG_LEVEL=INFO
MAX_UPLOAD_MB=15

# --- Weather (deterministic baseline only; there is no ML weather model) -------------------------
WEATHER_PROVIDER=open-meteo        # open-meteo | mock
WEATHER_FALLBACK=error             # error (production): provider failure -> HTTP 503/502, never synthetic numbers
                                   # mock  (default): provider failure -> explicitly labelled mock data
WEATHER_CACHE_TTL_S=600
WEATHER_FAILURE_COOLDOWN_S=30
DOWNSCALING_METHOD=baseline        # only "baseline" is enabled; anything else is ignored

# --- Disease detection models (separate from weather) -------------------------------------------
# true  -> the process REFUSES TO START if any of the 9 *_model.pth files (or yolov8n.pt) is missing or has the wrong size.
REQUIRE_DISEASE_MODELS=true
# Directory holding the model files. Default: backend/app/model (resolved from the code, not the working directory).
# MODEL_DIR=/opt/render/project/src/backend/app/model

# --- Artifact download at build time (used only by scripts/fetch_models.py) --------------------
# Base URL under which model_manifest.json's file names can be fetched, e.g. https://artifacts.example.com/cropcast/models-v1
MODEL_ARTIFACT_BASE_URL=https://artifacts.example.com/cropcast/models-v1
# Only if the store is private; sent as "Authorization: Bearer <token>". Never logged.
MODEL_ARTIFACT_TOKEN=replace-me
